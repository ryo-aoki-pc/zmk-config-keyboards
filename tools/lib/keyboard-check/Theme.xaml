<!--
  Dark theme shared by the WPF windows of tools/lib/keyboard-check/InputTestForm.cs
  (KcInputTestForm / KcInputMonitorForm / KcLayerTraceForm / KcFlashForm). KcUi.CreateWindow merges this dictionary into each window
  before the window content is parsed, so the window XAML refers to these keys with DynamicResource.
  Inside this file a key must be defined before a StaticResource refers to it.
  ASCII only: user-visible strings are passed in from PowerShell.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==== palette ==== -->
  <SolidColorBrush x:Key="KcBg" Color="#0F172A"/>
  <SolidColorBrush x:Key="KcChrome" Color="#0B1120"/>
  <SolidColorBrush x:Key="KcSurface" Color="#1E293B"/>
  <SolidColorBrush x:Key="KcSurfaceRaised" Color="#273449"/>
  <SolidColorBrush x:Key="KcSurfaceHover" Color="#334155"/>
  <SolidColorBrush x:Key="KcSurfacePressed" Color="#1A2436"/>
  <SolidColorBrush x:Key="KcBorder" Color="#334155"/>
  <SolidColorBrush x:Key="KcDivider" Color="#1E293B"/>
  <SolidColorBrush x:Key="KcText" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="KcTextMuted" Color="#94A3B8"/>
  <SolidColorBrush x:Key="KcTextFaint" Color="#64748B"/>
  <SolidColorBrush x:Key="KcOnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="KcAccent" Color="#2563EB"/>
  <SolidColorBrush x:Key="KcAccentHover" Color="#3B82F6"/>
  <SolidColorBrush x:Key="KcAccentPressed" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="KcAccentLight" Color="#60A5FA"/>
  <SolidColorBrush x:Key="KcRecording" Color="#EF4444"/>
  <SolidColorBrush x:Key="KcScrollThumbBrush" Color="#475569"/>
  <SolidColorBrush x:Key="KcScrollThumbHover" Color="#64748B"/>
  <SolidColorBrush x:Key="KcSelection" Color="#3B82F6"/>

  <!-- status: level 0 = info, 1 = ok, 2 = ng, 3 = warning (tint = banner background, edge = banner border,
       mark = icon circle, ink = text) -->
  <SolidColorBrush x:Key="KcInfoTint" Color="#172554"/>
  <SolidColorBrush x:Key="KcInfoEdge" Color="#1E3A8A"/>
  <SolidColorBrush x:Key="KcInfoMark" Color="#60A5FA"/>
  <SolidColorBrush x:Key="KcInfoInk" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="KcOkTint" Color="#052E16"/>
  <SolidColorBrush x:Key="KcOkEdge" Color="#166534"/>
  <SolidColorBrush x:Key="KcOkMark" Color="#4ADE80"/>
  <SolidColorBrush x:Key="KcOkInk" Color="#DCFCE7"/>
  <SolidColorBrush x:Key="KcNgTint" Color="#450A0A"/>
  <SolidColorBrush x:Key="KcNgEdge" Color="#991B1B"/>
  <SolidColorBrush x:Key="KcNgMark" Color="#F87171"/>
  <SolidColorBrush x:Key="KcNgInk" Color="#FEE2E2"/>
  <SolidColorBrush x:Key="KcWarnTint" Color="#422006"/>
  <SolidColorBrush x:Key="KcWarnEdge" Color="#92400E"/>
  <SolidColorBrush x:Key="KcWarnMark" Color="#FBBF24"/>
  <SolidColorBrush x:Key="KcWarnInk" Color="#FEF3C7"/>

  <!-- keys of the keyboard picture (Fill / Edge / Ink per state) -->
  <SolidColorBrush x:Key="KcKeyNormalFill" Color="#273449"/>
  <SolidColorBrush x:Key="KcKeyNormalEdge" Color="#3B4A63"/>
  <SolidColorBrush x:Key="KcKeyNormalInk" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="KcKeyCurrentFill" Color="#1E3A8A"/>
  <SolidColorBrush x:Key="KcKeyCurrentEdge" Color="#60A5FA"/>
  <SolidColorBrush x:Key="KcKeyCurrentInk" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="KcKeyPassFill" Color="#14532D"/>
  <SolidColorBrush x:Key="KcKeyPassEdge" Color="#22C55E"/>
  <SolidColorBrush x:Key="KcKeyPassInk" Color="#DCFCE7"/>
  <SolidColorBrush x:Key="KcKeyFailFill" Color="#7F1D1D"/>
  <SolidColorBrush x:Key="KcKeyFailEdge" Color="#F87171"/>
  <SolidColorBrush x:Key="KcKeyFailInk" Color="#FEE2E2"/>
  <SolidColorBrush x:Key="KcKeySkipFill" Color="#18233A"/>
  <SolidColorBrush x:Key="KcKeySkipEdge" Color="#475569"/>
  <SolidColorBrush x:Key="KcKeySkipInk" Color="#64748B"/>
  <Color x:Key="KcKeyGlowColor">#3B82F6</Color>
  <!-- keys held during a step: layer keys (violet) and modifiers (amber); keys pressed together (teal) -->
  <SolidColorBrush x:Key="KcKeyHoldFill" Color="#2E1065"/>
  <SolidColorBrush x:Key="KcKeyHoldEdge" Color="#A78BFA"/>
  <SolidColorBrush x:Key="KcKeyHoldInk" Color="#F5F3FF"/>
  <SolidColorBrush x:Key="KcKeyModFill" Color="#451A03"/>
  <SolidColorBrush x:Key="KcKeyModEdge" Color="#F59E0B"/>
  <SolidColorBrush x:Key="KcKeyModInk" Color="#FEF3C7"/>
  <SolidColorBrush x:Key="KcKeyComboFill" Color="#042F2E"/>
  <SolidColorBrush x:Key="KcKeyComboEdge" Color="#2DD4BF"/>
  <SolidColorBrush x:Key="KcKeyComboInk" Color="#CCFBF1"/>
  <!-- keys that must not be pressed (bootloader, reset, Bluetooth): red stripes -->
  <DrawingBrush x:Key="KcKeyDangerFill" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#1F0A0E">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,12,12"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#7F1D1D" Thickness="3"/>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="0,12" EndPoint="12,0"/>
              <LineGeometry StartPoint="-6,6" EndPoint="6,-6"/>
              <LineGeometry StartPoint="6,18" EndPoint="18,6"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="KcKeyDangerEdge" Color="#EF4444"/>
  <SolidColorBrush x:Key="KcKeyDangerInk" Color="#FCA5A5"/>
  <!-- small badge on a key: order of the presses, tap count -->
  <SolidColorBrush x:Key="KcBadgeFill" Color="#FBBF24"/>
  <SolidColorBrush x:Key="KcBadgeInk" Color="#0F172A"/>

  <!-- layer chips: the path of the current step and the overview of all layers -->
  <SolidColorBrush x:Key="KcLayerIdleFill" Color="#1E293B"/>
  <SolidColorBrush x:Key="KcLayerIdleEdge" Color="#334155"/>
  <SolidColorBrush x:Key="KcLayerIdleInk" Color="#94A3B8"/>
  <SolidColorBrush x:Key="KcLayerOnFill" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="KcLayerOnEdge" Color="#93C5FD"/>
  <SolidColorBrush x:Key="KcLayerOnInk" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="KcLayerArrow" Color="#64748B"/>

  <!-- key caps of the expected / actual input -->
  <SolidColorBrush x:Key="KcCapFill" Color="#273449"/>
  <SolidColorBrush x:Key="KcCapEdge" Color="#64748B"/>
  <SolidColorBrush x:Key="KcCapInk" Color="#F1F5F9"/>

  <!-- the corner between the two scroll bars of a ScrollViewer uses this system brush -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E293B"/>

  <!-- ==== fonts ==== -->
  <!-- WPF picks a font per character from the list: Latin from Segoe UI, Japanese from Yu Gothic UI -->
  <FontFamily x:Key="KcUiFont">Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>
  <!-- Japanese capable monospace font for the log -->
  <FontFamily x:Key="KcMonoFont">BIZ UDGothic, MS Gothic</FontFamily>

  <!-- ==== window ==== -->
  <Style x:Key="KcWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource KcBg}"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="FontFamily" Value="{StaticResource KcUiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <!-- ==== buttons ==== -->
  <!-- Buttons never take the keyboard focus, so Enter / Space of the tested keyboard cannot press them
       (a WPF Button reacts to the left mouse button only). -->
  <Style x:Key="KcButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinWidth" Value="112"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="Background" Value="{StaticResource KcSurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceHover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfacePressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="KcSecondaryButton" TargetType="Button" BasedOn="{StaticResource KcButton}"/>

  <Style x:Key="KcPrimaryButton" TargetType="Button" BasedOn="{StaticResource KcButton}">
    <Setter Property="Foreground" Value="{StaticResource KcOnAccent}"/>
    <Setter Property="Background" Value="{StaticResource KcAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcAccent}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcAccentHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KcAccentHover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource KcAccentPressed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KcAccentPressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="KcDangerButton" TargetType="Button" BasedOn="{StaticResource KcButton}">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource KcNgMark}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcNgEdge}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcNgTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KcNgMark}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource KcNgEdge}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==== thin progress bar of the window header ==== -->
  <Style x:Key="KcStepProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{StaticResource KcAccentLight}"/>
    <Setter Property="Background" Value="{StaticResource KcDivider}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"
                    CornerRadius="0,2,2,0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==== thin dark scroll bars (no arrow buttons); applies to every ScrollBar in the window ==== -->
  <Style x:Key="KcScrollThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{StaticResource KcScrollThumbBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcScrollThumbHover}"/>
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
        <Setter Property="Background" Value="{StaticResource KcScrollThumbHover}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource KcScrollThumb}" Margin="3,2"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource KcScrollThumb}" Margin="2,3"/>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==== read-only log of the input monitor ==== -->
  <Style x:Key="KcLogBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource KcMonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsUndoEnabled" Value="False"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="SelectionBrush" Value="{StaticResource KcSelection}"/>
    <Setter Property="CaretBrush" Value="{StaticResource KcText}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==== text and small parts ==== -->
  <Style x:Key="KcAppCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource KcAccentLight}"/>
  </Style>

  <Style x:Key="KcHeaderTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="KcChip" TargetType="Border">
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="Background" Value="{StaticResource KcSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="KcCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Background" Value="{StaticResource KcSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="KcLegendSwatch" TargetType="Border">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Margin" Value="18,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="KcLegendItem" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Visibility" Value="Collapsed"/>
  </Style>

  <Style x:Key="KcSectionCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource KcTextFaint}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>

  <Style x:Key="KcLegendText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource KcTextMuted}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="KcStatusIcon" TargetType="Path">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="Stroke" Value="{StaticResource KcBg}"/>
    <Setter Property="StrokeThickness" Value="2.6"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>

  <Style x:Key="KcFooter" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KcChrome}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcDivider}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="28,14"/>
  </Style>

  <Style x:Key="KcHeader" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource KcChrome}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcDivider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!-- ==== flashing tool (tools/flash.ps1, KcFlashForm) ==== -->
  <!-- Items of the keyboard list and the build list: radio buttons (one selected), never focused, so keys
       typed by the keyboard being flashed cannot change the selection. -->
  <Style x:Key="KcNavItem" TargetType="RadioButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8,12,8"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="2"
                    Background="{StaticResource KcAccentLight}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceHover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceRaised}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="KcBuildItem" TargetType="RadioButton" BasedOn="{StaticResource KcNavItem}">
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="Padding" Value="16,10,14,11"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceHover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KcAccentLight}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="KcGroupCaption" TargetType="TextBlock" BasedOn="{StaticResource KcSectionCaption}">
    <Setter Property="Margin" Value="4,10,0,6"/>
  </Style>

  <!-- segmented control: a row of radio buttons in a rounded bar -->
  <Style x:Key="KcSegmentBar" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{StaticResource KcBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="3"/>
  </Style>

  <Style x:Key="KcSegment" TargetType="RadioButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource KcTextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource KcText}"/>
        <Setter Property="Background" Value="{StaticResource KcSurfaceHover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource KcOnAccent}"/>
        <Setter Property="Background" Value="{StaticResource KcAccent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- one choice of a vertical list (radio dot, title and a description) -->
  <Style x:Key="KcChoice" TargetType="RadioButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <DockPanel Margin="{TemplateBinding Padding}">
              <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                <Ellipse x:Name="Ring" Stroke="{StaticResource KcTextFaint}" StrokeThickness="1.5"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource KcAccentLight}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter RecognizesAccessKey="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource KcAccentLight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceHover}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource KcSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KcAccentLight}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- small button in a card header (refresh) -->
  <Style x:Key="KcToolButton" TargetType="Button" BasedOn="{StaticResource KcButton}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <!-- read-only colored log (one paragraph per line) -->
  <Style x:Key="KcLogRich" TargetType="RichTextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource KcMonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsUndoEnabled" Value="False"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="SelectionBrush" Value="{StaticResource KcSelection}"/>
    <Setter Property="CaretBrush" Value="{StaticResource KcText}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RichTextBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- dark tool tips (full titles of the builds) -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource KcSurfaceRaised}"/>
    <Setter Property="Foreground" Value="{StaticResource KcText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource KcBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
</ResourceDictionary>
