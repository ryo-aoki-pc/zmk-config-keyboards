<!--
  Content of the tap-hold timing window of tools/scripts/keyboard-check.ps1 -Mode HoldTap (KcHoldTapForm in
  InputTestForm.cs): the settings (flavor and tapping term) on the left; the result and the timeline
  (KcTimelineView draws ChartCanvas) of the last hold-tap press on the right.
  Loaded with XamlReader: no x:Class, the named elements are looked up by C#.
  Theme keys (Theme.xaml) are referenced with DynamicResource because the theme is merged into the
  window after this content is parsed. ASCII only: texts are set from PowerShell.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource KcBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- header: title and what to do; the log port (logging firmware) on the right -->
  <Border Grid.Row="0" Style="{DynamicResource KcHeader}">
    <DockPanel>
      <Border x:Name="PortChip" DockPanel.Dock="Right" Style="{DynamicResource KcChip}" Margin="0,0,28,0"
              VerticalAlignment="Center" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="PortMark" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PortText" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource KcTextMuted}"/>
        </StackPanel>
      </Border>
      <StackPanel Margin="28,14,28,14">
        <TextBlock x:Name="TitleText" Style="{DynamicResource KcHeaderTitle}"/>
        <TextBlock x:Name="SubtitleText" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource KcTextMuted}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="20,16,20,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*" MinWidth="420"/>
    </Grid.ColumnDefinitions>

    <!-- left: the settings of the hold-tap behavior of the last press -->
    <Border x:Name="SideCard" Grid.Column="0" Style="{DynamicResource KcCard}" Padding="14,12,14,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
          <TextBlock x:Name="SettingsCaption" Style="{DynamicResource KcSectionCaption}" Margin="0,0,0,10"/>
          <TextBlock x:Name="FlavorCaption" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5"
                     Foreground="{DynamicResource KcText}"/>
          <StackPanel x:Name="FlavorPanel"/>
          <TextBlock x:Name="FlavorHint" FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0"
                     Foreground="{DynamicResource KcTextMuted}"/>
          <DockPanel Margin="0,16,0,5">
            <TextBlock x:Name="TermValue" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource KcAccentLight}"/>
            <TextBlock x:Name="TermCaption" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KcText}"/>
          </DockPanel>
          <Slider x:Name="TermSlider" Style="{DynamicResource KcSlider}" SmallChange="1" LargeChange="10"/>
          <Border x:Name="ChangedTag" HorizontalAlignment="Left" CornerRadius="5" Padding="6,0,6,1" Margin="0,14,0,0"
                  BorderThickness="1" Background="{DynamicResource KcWarnTint}" BorderBrush="{DynamicResource KcWarnEdge}"
                  Visibility="Collapsed">
            <TextBlock x:Name="ChangedText" FontSize="11.5" Foreground="{DynamicResource KcWarnInk}"/>
          </Border>
          <TextBlock x:Name="KeymapText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Foreground="{DynamicResource KcTextFaint}"/>
          <Button x:Name="ResetButton" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{DynamicResource KcToolButton}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- right: the result, the timeline and its legend -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="SummaryBanner" Grid.Row="0" CornerRadius="12" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Top">
            <Ellipse x:Name="SummaryMark"/>
            <Path x:Name="SummaryIcon" Style="{DynamicResource KcStatusIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel>
            <TextBlock x:Name="SummaryTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel x:Name="SummaryLines" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="ChartCard" Grid.Row="1" Style="{DynamicResource KcCard}" Padding="6,8,6,6">
        <Grid>
          <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
            <Canvas x:Name="ChartCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
          <TextBlock x:Name="ChartMessage" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource KcTextMuted}" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <WrapPanel x:Name="LegendPanel" Grid.Row="2" Margin="4,10,0,0"/>
    </Grid>
  </Grid>

  <Border x:Name="Footer" Grid.Row="2" Style="{DynamicResource KcFooter}">
    <DockPanel LastChildFill="True">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource KcPrimaryButton}"/>
      <TextBlock x:Name="StatusText" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource KcTextMuted}"/>
    </DockPanel>
  </Border>
</Grid>
