<!--
  Content of the tap-hold timing window of tools/keyboard-check.ps1 -Mode HoldTap (KcHoldTapForm in
  InputTestForm.cs): the target key, the presets, the key presses read from the logging firmware and the
  settings on the left; the result and the timeline (KcTimelineView draws ChartCanvas) on the right.
  Loaded with XamlReader: no x:Class, the named elements are looked up by C#.
  Theme keys (Theme.xaml) are referenced with DynamicResource because the theme is merged into the
  window after this content is parsed. ASCII only: texts are set from PowerShell.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource KcBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- header: title and keyboard; the log port (logging firmware) on the right -->
  <Border Grid.Row="0" Style="{DynamicResource KcHeader}">
    <DockPanel>
      <Border x:Name="PortChip" DockPanel.Dock="Right" Style="{DynamicResource KcChip}" Margin="0,0,28,0"
              Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="PortMark" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PortText" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource KcTextMuted}"/>
        </StackPanel>
      </Border>
      <StackPanel Margin="28,14,28,14">
        <TextBlock x:Name="TitleText" Style="{DynamicResource KcHeaderTitle}"/>
        <TextBlock x:Name="SubtitleText" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KcTextMuted}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="20,16,20,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*" MinWidth="420"/>
    </Grid.ColumnDefinitions>

    <!-- left: what to look at, and the settings -->
    <Border x:Name="SideCard" Grid.Column="0" Style="{DynamicResource KcCard}" Padding="14,12,6,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock x:Name="KeysCaption" Style="{DynamicResource KcSectionCaption}" Margin="0,0,0,8"/>
          <StackPanel x:Name="KeyPanel"/>
          <TextBlock x:Name="PresetsCaption" Style="{DynamicResource KcSectionCaption}" Margin="0,14,0,8"/>
          <StackPanel x:Name="PresetPanel"/>
          <StackPanel x:Name="EpisodesBox" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="EpisodesCaption" Style="{DynamicResource KcSectionCaption}" Margin="0,0,0,8"/>
            <StackPanel x:Name="FollowPanel"/>
            <TextBlock x:Name="EpisodesEmpty" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                       Foreground="{DynamicResource KcTextFaint}"/>
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,6,0,0">
              <StackPanel x:Name="EpisodeList"/>
            </ScrollViewer>
          </StackPanel>
          <DockPanel Margin="0,16,0,4">
            <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{DynamicResource KcToolButton}"/>
            <TextBlock x:Name="ParamsCaption" Style="{DynamicResource KcSectionCaption}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="ParamsNote" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource KcTextFaint}"/>
          <StackPanel x:Name="ParamPanel"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- right: the result, the timeline and its legend -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="SummaryBanner" Grid.Row="0" CornerRadius="12" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Top">
            <Ellipse x:Name="SummaryMark"/>
            <Path x:Name="SummaryIcon" Style="{DynamicResource KcStatusIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel>
            <TextBlock x:Name="SummaryTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel x:Name="SummaryLines" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="ChartCard" Grid.Row="1" Style="{DynamicResource KcCard}" Padding="6,8,6,6">
        <Grid>
          <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
            <Canvas x:Name="ChartCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
          <TextBlock x:Name="ChartMessage" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource KcTextMuted}" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <WrapPanel x:Name="LegendPanel" Grid.Row="2" Margin="4,10,0,0"/>
    </Grid>
  </Grid>

  <Border x:Name="Footer" Grid.Row="2" Style="{DynamicResource KcFooter}">
    <DockPanel LastChildFill="True">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource KcPrimaryButton}"/>
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <TextBlock x:Name="StatusText" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource KcTextMuted}"/>
    </DockPanel>
  </Border>
</Grid>
