<!--
  Content of the window of tools/scripts/flash.ps1 (KcFlashForm in InputTestForm.cs): the select page (keyboard,
  build and options) and the run page (steps, instructions and the log of the flashing scripts).
  Loaded with XamlReader: no x:Class, the named elements are looked up by C#.
  Theme keys (Theme.xaml) are referenced with DynamicResource because the theme is merged into the
  window after this content is parsed. ASCII only: texts are set from PowerShell.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource KcBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- header: title, repository and where the build list came from; progress of the steps at the bottom -->
  <Border Grid.Row="0" Style="{DynamicResource KcHeader}">
    <DockPanel>
      <ProgressBar x:Name="StepProgress" DockPanel.Dock="Bottom" Style="{DynamicResource KcStepProgress}" Visibility="Hidden"/>
      <Border x:Name="SourceChip" DockPanel.Dock="Right" Style="{DynamicResource KcChip}" Margin="0,0,28,0"
              Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="SourceMark" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="SourceText" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource KcTextMuted}"/>
        </StackPanel>
      </Border>
      <StackPanel Margin="28,16,28,16">
        <TextBlock x:Name="AppCaption" Style="{DynamicResource KcAppCaption}"/>
        <TextBlock x:Name="TitleText" Style="{DynamicResource KcHeaderTitle}" Margin="0,2,0,0"/>
        <TextBlock x:Name="SubtitleText" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KcTextMuted}"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <!-- select page: keyboard / build / options and steps. The build and option columns share the width
       (the window is made smaller than its default on small screens), the options up to 400 -->
  <Grid x:Name="SelectPage" Grid.Row="1" Margin="20,18,20,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="5*" MinWidth="260"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="4*" MinWidth="290" MaxWidth="400"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="KeyboardsCard" Grid.Column="0" Style="{DynamicResource KcCard}" Padding="10,14,10,10">
      <DockPanel>
        <TextBlock x:Name="KeyboardsCaption" DockPanel.Dock="Top" Style="{DynamicResource KcSectionCaption}" Margin="6,0,0,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="KeyboardList"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border x:Name="BuildsCard" Grid.Column="2" Style="{DynamicResource KcCard}" Padding="14,12,10,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,4,10">
          <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{DynamicResource KcToolButton}"/>
          <Border DockPanel.Dock="Right" Style="{DynamicResource KcSegmentBar}" Margin="0,0,0,0" HorizontalAlignment="Right">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal"/>
          </Border>
          <TextBlock x:Name="BuildsCaption" Style="{DynamicResource KcSectionCaption}"/>
        </DockPanel>
        <Border x:Name="BuildsMessage" Grid.Row="1" CornerRadius="10" BorderThickness="1" Padding="12,8"
                Margin="0,0,4,10" Visibility="Collapsed">
          <TextBlock x:Name="BuildsMessageText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
          <StackPanel x:Name="BuildList"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border x:Name="OptionsCard" Grid.Column="4" Style="{DynamicResource KcCard}" Padding="16,12,8,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock x:Name="OptionsCaption" Style="{DynamicResource KcSectionCaption}"/>
          <StackPanel x:Name="OptionsPanel"/>
          <TextBlock x:Name="PlanCaption" Style="{DynamicResource KcSectionCaption}" Margin="0,16,0,8"/>
          <StackPanel x:Name="PlanSteps"/>
          <Border x:Name="PlanNote" CornerRadius="10" BorderThickness="1" Padding="12,8" Margin="0,10,0,0"
                  Visibility="Collapsed">
            <TextBlock x:Name="PlanNoteText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <!-- run page: steps on the left, instructions and log on the right -->
  <Grid x:Name="RunPage" Grid.Row="1" Margin="20,18,20,16" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{DynamicResource KcCard}" Padding="14,12,10,12">
      <DockPanel>
        <TextBlock x:Name="RunStepsCaption" DockPanel.Dock="Top" Style="{DynamicResource KcSectionCaption}" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="RunSteps"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="Banner" Grid.Row="0" CornerRadius="12" BorderThickness="1" Padding="16,14">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Top">
            <Ellipse x:Name="BannerMark"/>
            <Path x:Name="BannerIcon" Style="{DynamicResource KcStatusIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel>
            <TextBlock x:Name="BannerTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="BannerText" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="LogCaption" Grid.Row="1" Style="{DynamicResource KcSectionCaption}" Margin="2,14,0,8"/>
      <Border Grid.Row="2" Style="{DynamicResource KcCard}" Padding="2">
        <RichTextBox x:Name="LogBox" Style="{DynamicResource KcLogRich}"/>
      </Border>
    </Grid>
  </Grid>

  <!-- cancel on the left, status in the middle, buttons on the right -->
  <Border x:Name="Footer" Grid.Row="2" Style="{DynamicResource KcFooter}">
    <DockPanel LastChildFill="True">
      <Button x:Name="CancelButton" DockPanel.Dock="Left" Style="{DynamicResource KcDangerButton}" Margin="0,0,14,0"/>
      <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{DynamicResource KcPrimaryButton}"/>
      <Button x:Name="ContinueButton" DockPanel.Dock="Right" Style="{DynamicResource KcPrimaryButton}"/>
      <Button x:Name="RetryButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <TextBlock x:Name="StatusText" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource KcTextMuted}"/>
    </DockPanel>
  </Border>
</Grid>
