<!--
  Simulator browser: board and scenario selection, a keyboard replay and read-only result panes.
  KcSimulatorForm in InputTestForm.cs loads this content and supplies all user-visible text.
  Theme keys use DynamicResource. No device input is registered by this window.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource KcBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Style="{DynamicResource KcHeader}" Padding="24,14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock x:Name="TitleText" Style="{DynamicResource KcHeaderTitle}"/>
        <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"
                   Foreground="{DynamicResource KcTextMuted}"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Style="{DynamicResource KcToolButton}"/>
        <Button x:Name="StandardButton" Style="{DynamicResource KcToolButton}"/>
        <Button x:Name="ReportButton" Style="{DynamicResource KcToolButton}" IsEnabled="False"/>
      </WrapPanel>
    </Grid>
  </Border>

  <Border Grid.Row="1" Margin="20,12,20,0" Style="{DynamicResource KcCard}" Padding="12,8">
    <DockPanel>
      <TextBlock x:Name="BoardsCaption" DockPanel.Dock="Left" Style="{DynamicResource KcSectionCaption}"
                 Margin="0,7,12,0"/>
      <WrapPanel x:Name="BoardPanel"/>
    </DockPanel>
  </Border>

  <Grid Grid.Row="2" Margin="20,12,20,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{DynamicResource KcCard}" Padding="10,12,6,6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ScenariosCaption" Style="{DynamicResource KcSectionCaption}" Margin="6,0,6,10"/>
        <ScrollViewer x:Name="ScenarioScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="ScenarioPanel"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0,0,6,0">
      <StackPanel>
        <Border x:Name="SummaryBanner" CornerRadius="10" Padding="14,10" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="SummaryTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SummaryDetail" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource KcCard}" Margin="0,10,0,0" Padding="14,10">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="PictureCaption" DockPanel.Dock="Left" Style="{DynamicResource KcSectionCaption}"
                         Margin="0,0,12,0"/>
              <TextBlock x:Name="ScenarioTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="SourceText" FontSize="11.5" Foreground="{DynamicResource KcTextFaint}"
                       TextWrapping="Wrap" Margin="0,4,0,4"/>
            <Viewbox Height="154" Margin="0,8,0,8" Stretch="Uniform" StretchDirection="DownOnly">
              <Canvas x:Name="KeyboardCanvas" Background="Transparent"/>
            </Viewbox>
            <DockPanel Margin="0,4,0,0">
              <Button x:Name="PlayButton" DockPanel.Dock="Right" Style="{DynamicResource KcToolButton}" IsEnabled="False"/>
              <TextBlock x:Name="ReplayTime" DockPanel.Dock="Right" Width="128" TextAlignment="Right"
                         Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource KcAccentLight}"/>
              <TextBlock x:Name="ReplayCaption" DockPanel.Dock="Left" FontSize="12.5" VerticalAlignment="Center"
                         Margin="0,0,10,0" Foreground="{DynamicResource KcTextMuted}"/>
              <Slider x:Name="ReplaySlider" Style="{DynamicResource KcSlider}" VerticalAlignment="Center"
                      Minimum="0" Maximum="1" SmallChange="1" LargeChange="20" TickFrequency="1"
                      IsSnapToTickEnabled="True" IsEnabled="False"/>
            </DockPanel>
            <TextBlock x:Name="ReplayStateText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource KcTextMuted}"/>
          </StackPanel>
        </Border>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{DynamicResource KcCard}">
            <DockPanel>
              <TextBlock x:Name="InputsCaption" DockPanel.Dock="Top" Style="{DynamicResource KcSectionCaption}" Margin="12,10,12,0"/>
              <TextBox x:Name="InputsBox" Style="{DynamicResource KcLogBox}" Height="188" FontSize="12" IsTabStop="True"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{DynamicResource KcCard}">
            <DockPanel>
              <TextBlock x:Name="ExpectedCaption" DockPanel.Dock="Top" Style="{DynamicResource KcSectionCaption}" Margin="12,10,12,0"/>
              <TextBox x:Name="ExpectedBox" Style="{DynamicResource KcLogBox}" Height="188" FontSize="12" IsTabStop="True"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="4" Style="{DynamicResource KcCard}">
            <DockPanel>
              <TextBlock x:Name="ActualCaption" DockPanel.Dock="Top" Style="{DynamicResource KcSectionCaption}" Margin="12,10,12,0"/>
              <TextBox x:Name="ActualBox" Style="{DynamicResource KcLogBox}" Height="188" FontSize="12" IsTabStop="True"/>
            </DockPanel>
          </Border>
        </Grid>

        <Expander Margin="0,10,0,0" Foreground="{DynamicResource KcTextMuted}">
          <Expander.Header>
            <TextBlock x:Name="LogCaption" FontSize="12.5"/>
          </Expander.Header>
          <Border Style="{DynamicResource KcCard}" Margin="0,6,0,0">
            <TextBox x:Name="LogBox" Style="{DynamicResource KcLogBox}" Height="116" FontSize="12" IsTabStop="True"/>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <Border Grid.Row="3" Style="{DynamicResource KcFooter}">
    <DockPanel>
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <WrapPanel>
        <Button x:Name="RunButton" Style="{DynamicResource KcPrimaryButton}" Margin="0,0,0,0" IsEnabled="False"/>
        <Button x:Name="RunAllButton" Style="{DynamicResource KcSecondaryButton}" IsEnabled="False"/>
        <Button x:Name="CancelButton" Style="{DynamicResource KcDangerButton}" IsEnabled="False"/>
      </WrapPanel>
    </DockPanel>
  </Border>
</Grid>
