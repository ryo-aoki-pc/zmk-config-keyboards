<!--
  Content of the window of the interactive test of tools/keyboard-check.ps1 (KcInputTestForm in
  InputTestForm.cs). Loaded with XamlReader: no x:Class, the named elements are looked up by C#.
  Theme keys (Theme.xaml) are referenced with DynamicResource because the theme is merged into the
  window after this content is parsed. ASCII only: texts are set from PowerShell.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource KcBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- header: tool name, step title, keyboard name, progress of the step -->
  <Border Grid.Row="0" Style="{DynamicResource KcHeader}">
    <Grid>
      <Grid Margin="28,16,28,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="AppCaption" Text="KEYBOARD-CHECK" Style="{DynamicResource KcAppCaption}"/>
          <TextBlock x:Name="TitleText" Style="{DynamicResource KcHeaderTitle}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border x:Name="SubtitleChip" Grid.Column="1" Style="{DynamicResource KcChip}" Margin="16,0,0,0"
                Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource KcOkMark}" Margin="0,0,8,0"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KcText}"/>
          </StackPanel>
        </Border>
      </Grid>
      <ProgressBar x:Name="StepProgress" VerticalAlignment="Bottom" Style="{DynamicResource KcStepProgress}"
                   Minimum="0" Maximum="1" Value="0" Visibility="Hidden"/>
    </Grid>
  </Border>

  <!-- instruction, keyboard picture, result of the step -->
  <Grid Grid.Row="1" Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource KcText}"/>
    <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource KcTextMuted}" Visibility="Collapsed"/>

    <Border x:Name="KeyboardCard" Grid.Row="2" Style="{DynamicResource KcCard}" Margin="0,18,0,0"
            Padding="20,18,20,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox x:Name="KeyboardView" Grid.Row="0" Stretch="Uniform" TextOptions.TextFormattingMode="Ideal">
          <Canvas x:Name="KeyboardCanvas"/>
        </Viewbox>
        <StackPanel x:Name="Legend" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,14,0,0" Visibility="Collapsed">
          <Border Style="{DynamicResource KcLegendSwatch}" Margin="0,0,6,0"
                  Background="{DynamicResource KcKeyCurrentFill}" BorderBrush="{DynamicResource KcKeyCurrentEdge}"/>
          <TextBlock x:Name="LegendCurrent" Style="{DynamicResource KcLegendText}"/>
          <Border Style="{DynamicResource KcLegendSwatch}"
                  Background="{DynamicResource KcKeyPassFill}" BorderBrush="{DynamicResource KcKeyPassEdge}"/>
          <TextBlock x:Name="LegendPass" Style="{DynamicResource KcLegendText}"/>
          <Border Style="{DynamicResource KcLegendSwatch}"
                  Background="{DynamicResource KcKeyFailFill}" BorderBrush="{DynamicResource KcKeyFailEdge}"/>
          <TextBlock x:Name="LegendFail" Style="{DynamicResource KcLegendText}"/>
          <Border Style="{DynamicResource KcLegendSwatch}"
                  Background="{DynamicResource KcKeySkipFill}" BorderBrush="{DynamicResource KcKeySkipEdge}"/>
          <TextBlock x:Name="LegendSkip" Style="{DynamicResource KcLegendText}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- hidden (not collapsed) while empty, so the keyboard picture does not jump -->
    <Border x:Name="StatusBanner" Grid.Row="3" Margin="0,14,0,0" MinHeight="50" CornerRadius="10"
            BorderThickness="1" Padding="14,10" Visibility="Hidden"
            Background="{DynamicResource KcInfoTint}" BorderBrush="{DynamicResource KcInfoEdge}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse x:Name="StatusMark" Fill="{DynamicResource KcInfoMark}"/>
          <Path x:Name="StatusIcon" Style="{DynamicResource KcStatusIcon}"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource KcInfoInk}"/>
      </Grid>
    </Border>

    <TextBlock x:Name="LogText" Grid.Row="4" FontSize="12.5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource KcTextFaint}" Visibility="Collapsed"/>
  </Grid>

  <!-- buttons: abort apart on the left, the main action on the right -->
  <Border x:Name="Footer" Grid.Row="2" Style="{DynamicResource KcFooter}">
    <DockPanel LastChildFill="False">
      <Button x:Name="AbortButton" DockPanel.Dock="Left" Style="{DynamicResource KcDangerButton}"/>
      <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{DynamicResource KcPrimaryButton}"/>
      <Button x:Name="RetryButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
      <Button x:Name="SkipButton" DockPanel.Dock="Right" Style="{DynamicResource KcSecondaryButton}"/>
    </DockPanel>
  </Border>
</Grid>
